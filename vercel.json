{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "Analógicas/**",
      "use": "@vercel/static"
    },
    {
      "src": "Calle/**",
      "use": "@vercel/static"
    },
    {
      "src": "Estudio/**",
      "use": "@vercel/static"
    },
    {
      "src": "Natura/**",
      "use": "@vercel/static"
    },
    {
      "src": "Shows/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
